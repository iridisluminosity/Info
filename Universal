            "Enemy", -- Name
            plr_character, -- Character
            nil_instance, -- Humanoid
            root, -- Root
            true, -- Should aimbot
            vector3(1, 0, 1), -- Min
            vector3(1, 1, 1), -- Max
            { -- Body parts
                { "Head", head }, -- Defines the head instance for custom hitpart
                { "Torso", torso }
            }
        )
    end
end)
